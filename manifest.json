{
  "manifest_version": 3,
  "name": "Bocchi Privacy Shield",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "description": "Native anti-fingerprinting and privacy protection extension for Chrome.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "privacy",
    "storage",
    "fontSettings"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Bocchi Privacy Shield",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "panel/panel.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cyt_rules",
        "enabled": true,
        "path": "rules/cyt_rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/stealth_engine.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}