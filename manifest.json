{
  "manifest_version": 3,
  "name": "Bocchi",
  "version": "1.1.0",
  "minimum_chrome_version": "111",
  "description": "Privacy-first browser extension for fingerprint protection, WebRTC leak prevention, and timezone spoofing.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "privacy",
    "storage",
    "fontSettings",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Bocchi",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "panel/panel.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cyt_rules",
        "enabled": true,
        "path": "rules/cyt_rules.json"
      }
    ]
  }
}